# Market data configuration (build-time, passed via --dart-define).
# Never commit real keys. The app ships with NO embedded secrets.

# Candle service (Twelve Data free tier, XAU/USD spot):
#   flutter run --dart-define=MARKET_DATA_API_KEY=your_key_here
MARKET_DATA_API_KEY=

# Quote provider. Default: swissquote public feed (no key needed).
MARKET_DATA_PROVIDER=swissquote

# Quote poll interval in milliseconds (free feeds are REST-only).
MARKET_DATA_POLL_MS=5000
